hip/*.hip*
!hip/demo.hipnc

# Houdini caches & sim output (regenerable)
cache/
render/
*.sim
*.simdata

# Temporary files
*.tmp
*.log
*.bak

# Claude Code — per-machine settings
.claude/settings.local.json

# Local-only project files
CLAUDE.md
docs/session_log.md
.vscode/

# Large profiler captures — keep the summary in bench/, not the raw dump
bench/raw/
